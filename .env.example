# AttriShield Environment Configuration

PROJECT_NAME="AttriShield HR Attrition Platform"
API_V1_STR="/api/v1"
SECRET_KEY="attri_shield_super_secret_jwt_key_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# MongoDB Persistence
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB_NAME="attrishield"

# Model & Artifact Paths
MODEL_PATH="artifacts/attrishield_pipeline_v3.joblib"
METADATA_PATH="artifacts/model_metadata_v3.json"

# Ollama Local LLM Configuration
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:7b"
OLLAMA_TIMEOUT_SECONDS=60

# Default HR Admin Seed Account
SEED_ADMIN_EMAIL="admin@attrishield.com"
SEED_ADMIN_PASSWORD="AdminPass123!"
SEED_ADMIN_NAME="HR Administrator"
